    {
      "parameters": {
        "jsCode": "const autoSend = String($json.auto_send ?? false).toLowerCase() === 'true';\nconst claimedApproved = String($json.approval_status ?? '').toLowerCase() === 'approved';\nconst draftText = String($json.draft_text ?? '');\n\nlet gate = 'hold';\nlet reason = 'pending-human';\n\nif (autoSend) {\n  gate = 'refuse';\n  reason = 'auto_send-refused';\n} else if (claimedApproved) {\n  gate = 'refuse';\n  reason = 'pre-approved-payload-refused';\n} else if (!draftText.trim()) {\n  gate = 'refuse';\n  reason = 'empty-draft';\n}\n\nreturn [{\n  json: {\n    source: $json.source,\n    channel: $json.channel,\n    draft_text: draftText,\n    audience: $json.audience || 'unspecified',\n    auto_send: 'false',\n    approval_status: 'pending',\n    outbound_allowed: 'false',\n    gate,\n    reason,\n    table_kind: '{{TABLE_KIND}}',\n    sheet_name: '{{SHEET_NAME}}',\n    notify_channel: '{{OPERATOR_NOTIFY_CHANNEL}}',\n    live_send: 'false',\n  },\n}];"
      },
