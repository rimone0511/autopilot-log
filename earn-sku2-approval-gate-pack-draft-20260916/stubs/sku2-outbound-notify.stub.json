      "id": "dddddddd-0002-4000-8000-000000000003",
      "name": "Read decision STUB",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 320]
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.decision ?? '').trim().toLowerCase();\nconst autoSend = String($json.auto_send ?? false).toLowerCase() === 'true';\n\nlet branch = 'fail_closed';\nlet reason = 'missing-or-unknown-decision';\n\nif (autoSend) {\n  branch = 'fail_closed';\n  reason = 'auto_send-refused';\n} else if (raw === 'approve') {\n  branch = 'approve';\n  reason = 'human-approve';\n} else if (raw === 'reject' || raw === 'deny' || raw === 'decline') {\n  branch = 'reject';\n  reason = 'human-reject';\n} else if (raw === 'timeout' || raw === 'expired') {\n  branch = 'fail_closed';\n  reason = 'timeout-is-not-approve';\n}\n\nreturn [{\n  json: {\n    decision_raw: raw,\n    branch,\n    reason,\n    approver_label: $json.approver_label,\n    note: $json.note,\n    outbound_allowed: branch === 'approve' ? 'placeholder-only' : 'false',\n    live_send: 'false',\n    notify_channel: '{{OPERATOR_NOTIFY_CHANNEL}}',\n  },\n}];"
      },
      "id": "dddddddd-0002-4000-8000-000000000004",
