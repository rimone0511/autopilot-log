    {
      "parameters": {
        "jsCode": "const autoSend = String($json.auto_send ?? false).toLowerCase() === 'true';\nconst alreadySent = String($json.already_sent ?? false).toLowerCase() === 'true';\nconst rowIndex = String($json.row_index ?? '').trim();\nconst note = String($json.note ?? '');\nconst status = String($json.status ?? '').trim();\n\nlet gate = 'hold';\nlet reason = 'pending-human';\n\nif (autoSend) {\n  gate = 'refuse';\n  reason = 'auto_send-refused';\n} else if (alreadySent) {\n  gate = 'refuse';\n  reason = 'already-sent-payload-refused';\n} else if (!rowIndex && !note) {\n  gate = 'refuse';\n  reason = 'empty-row';\n}\n\nreturn [{\n  json: {\n    event: $json.event || 'row_added',\n    sheet_name: $json.sheet_name || '{{SHEET_NAME}}',\n    row_index: rowIndex || 'unspecified',\n    status: status || 'new',\n    note,\n    auto_send: 'false',\n    already_sent: 'false',\n    outbound_allowed: 'false',\n    gate,\n    reason,\n    google_sheet_id_token: '{{GOOGLE_SHEET_ID_DO_NOT_COMMIT}}',\n    sheets_credential_name: '{{GOOGLE_SHEETS_CREDENTIAL_NAME}}',\n    notify_channel: '{{OPERATOR_NOTIFY_CHANNEL}}',\n    live_send: 'false',\n  },\n}];"
      },
