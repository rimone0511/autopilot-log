      "parameters": {
        "jsCode": "const autoSend = String($json.auto_send ?? false).toLowerCase() === 'true';\nconst liveSend = String($json.live_send ?? false).toLowerCase() === 'true';\n\nlet branch = 'notify_human';\nlet reason = 'operator-ping-only';\n\nif (autoSend || liveSend) {\n  branch = 'fail_closed';\n  reason = 'auto_send-refused';\n}\n\nreturn [{\n  json: {\n    sheet_name: $json.sheet_name || '{{SHEET_NAME}}',\n    row_index: String($json.row_index ?? 'unspecified'),\n    status: $json.status || 'new',\n    note: $json.note || '',\n    branch,\n    reason,\n    notify_channel: '{{OPERATOR_NOTIFY_CHANNEL}}',\n    outbound_allowed: 'false',\n    live_send: 'false',\n    auto_send: 'false',\n  },\n}];"
      },
