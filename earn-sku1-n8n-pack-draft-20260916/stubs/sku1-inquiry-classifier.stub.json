    {
      "parameters": {
        "jsCode": "const subject = String($json.subject ?? '');\nconst body = String($json.body ?? '');\nconst text = `${subject} ${body}`.toLowerCase();\n\nlet label = 'uncertain';\nif (/\\binvoice\\b|\\breceipt\\b|\\bpayment\\b|\\b請求\\b|\\b領収\\b|\\b支払/.test(text)) {\n  label = 'billing';\n} else if (/\\bhow to\\b|\\bbroken\\b|\\berror\\b|\\b使い方\\b|\\b不具合\\b|\\b動かない/.test(text)) {\n  label = 'support';\n} else if (/\\bquote\\b|\\bhire\\b|\\bproposal\\b|\\b見積\\b|\\b依頼\\b|\\b発注/.test(text)) {\n  label = 'sales';\n}\n\nreturn [{\n  json: {\n    source: $json.source,\n    subject,\n    body,\n    from_label: $json.from_label,\n    label,\n    classifier: 'sku1-stub-keyword-rules',\n    accuracy_claim: 'none',\n    next: label === 'uncertain' ? 'hold-queue' : 'operator-review',\n  },\n}];"
      },
